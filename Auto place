local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local spawnTower = ReplicatedStorage.Functions.SpawnTower

task.spawn(function()
    while true do
        local upgrade = player.PlayerGui.GameGui.UnitManager.All.Upgrade

        if upgrade:IsA("GuiButton") then
            firesignal(upgrade.Activated)
        end

        task.wait(0.5)
    end
end)

local positions = {
    Vector3.new(20.852458953857422, -93.30819702148438, 59.62067413330078),
    Vector3.new(18.167613983154297, -93.30819702148438, 56.619293212890625),
    Vector3.new(20.74317169189453, -93.30819702148438, 56.65580368041992)
}

while true do
    for _, position in ipairs(positions) do
        local args = {
            [1] = "Scout Egg",
            [2] = CFrame.new(position) * CFrame.Angles(0, 0, 0),
            [3] = false,
            [4] = "Scout Egg Rainbow",
            [5] = {
                [1] = "Rainbow"
            }
        }

        spawnTower:InvokeServer(unpack(args))

        task.wait(1)
    end
end