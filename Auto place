        CFrame.new(47.24150085449219, -93.30819702148438, -14.536262512207031)
            * CFrame.Angles(-0, 0, -0)
    }

    for _, cframe in ipairs(positions) do
        if countTowers("Scout Egg") >= 3 then
            break
        end

