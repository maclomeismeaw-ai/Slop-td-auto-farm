local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local spawnTower = ReplicatedStorage.Functions.SpawnTower

task.spawn(function()
    while true do
        local upgrade = player.PlayerGui.GameGui.UnitManager.All.Upgrade

        if upgrade:IsA("GuiButton") then
            firesignal(upgrade.Activated)
        end

        task.wait(0.5)
    end
end)

task.spawn(function()
    local positions = {
        Vector3.new(20.852458953857422, -93.30819702148438, 59.62067413330078),
        Vector3.new(18.167613983154297, -93.30819702148438, 56.619293212890625),
        Vector3.new(-19.582534790039062, -93.30819702148438, -4.966239929199219)
    }

    while true do
        for _, position in ipairs(positions) do
            local args = {
                [1] = "Scout Egg",
                [2] = CFrame.new(position),
                [3] = false,
                [4] = "Scout Egg Rainbow",
                [5] = {
                    [1] = "Rainbow"
                }
            }

            spawnTower:InvokeServer(unpack(args))
            task.wait(0.5)
        end
    end
end)

