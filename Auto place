local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local cash = player:WaitForChild("Cash")
local spawnTower = ReplicatedStorage.Functions.SpawnTower

task.spawn(function()
    while true do
        local upgrade = player.PlayerGui.GameGui.UnitManager.All.Upgrade

        if upgrade:IsA("GuiButton") then
            firesignal(upgrade.Activated)
        end

        task.wait(0.5)
    end
end)

local function waitForCash(amount)
    repeat
        task.wait(0.1)
    until cash.Value >= amount
end

local function spawnScoutEgg(position)
    local args = {
        [1] = "Scout Egg",
        [2] = CFrame.new(position) * CFrame.Angles(-0, 0, -0),
        [3] = false,
        [4] = "Scout Egg",
        [5] = {}
    }

    spawnTower:InvokeServer(unpack(args))
end

