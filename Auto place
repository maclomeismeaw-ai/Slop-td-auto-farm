local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local spawnTower = ReplicatedStorage.Functions.SpawnTower
local towers = workspace.Towers

task.spawn(function()
    while true do
        local upgrade = player.PlayerGui.GameGui.UnitManager.All.Upgrade

        if upgrade:IsA("GuiButton") then
            firesignal(upgrade.Activated)
        end

        task.wait(0.5)
    end
end)

local function countTowers(name)
    local count = 0

    for _, tower in ipairs(towers:GetChildren()) do
        if tower.Name == name then
            count += 1
        end
    end

    return count
end

task.spawn(function()
    local positions = {
        CFrame.new(20.08582305908203, -93.30819702148438, 56.9916877746582)
            * CFrame.Angles(6.984919309616089e-10, -1.0913936421275139e-11, -2.9587450382524e-14),

