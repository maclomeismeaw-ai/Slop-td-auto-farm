local player = game:GetService("Players").LocalPlayer
local gui = player.PlayerGui.GameGui

local function waitAndFire(button)
    repeat
        task.wait(1)
    until button.Visible

    repeat
        firesignal(button.MouseButton1Click)
        task.wait(1)
    until not button.Visible
end

waitAndFire(gui.Voting.Universes.Space)
waitAndFire(gui.Voting.Maps.SpaceEndless)
waitAndFire(gui.ComplicationVoting.Modes.Nightmare)