local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local mutatorVoting = Players.LocalPlayer.PlayerGui
    :WaitForChild("SlopMutatorGui")
    :WaitForChild("MutatorVoting")

local event = ReplicatedStorage.Events.SlopMutator

local function voteAll()
    local votes = {
        "Blackout",
        "TinySlop",
        "Brainrot",
        "Regeneration",
        "None"
    }

    for _, mutator in ipairs(votes) do
        event:FireServer("Vote", mutator)
        task.wait(1)
    end
end

mutatorVoting:GetPropertyChangedSignal("Visible"):Connect(function()
    if mutatorVoting.Visible then
        voteAll()
    end
end)

if mutatorVoting.Visible then
    voteAll()
end