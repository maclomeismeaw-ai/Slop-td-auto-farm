local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local endScreen = Players.LocalPlayer.PlayerGui.GameGui.EndScreen
local endDecision = ReplicatedStorage.Events.EndDecision

endScreen:GetPropertyChangedSignal("Visible"):Connect(function()
    if endScreen.Visible then
        local args = {
            [1] = true
        }

        endDecision:FireServer(unpack(args))

        task.wait(10)

        loadstring(game:HttpGet("https://raw.githubusercontent.com/2sneaky/rbxscripts.github.io/refs/heads/main/simple_rejoin"))()
    end
end)