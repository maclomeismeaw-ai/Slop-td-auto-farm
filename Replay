local endScreen = game:GetService("Players").LocalPlayer.PlayerGui.GameGui.EndScreen
local event = game:GetService("ReplicatedStorage").Events.EndDecision

endScreen:GetPropertyChangedSignal("Visible"):Connect(function()
    if endScreen.Visible then
        local args = {
            [1] = true
        }

        event:FireServer(unpack(args))
    end
end)